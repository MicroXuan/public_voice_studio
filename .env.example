# Comma-separated official frontend origins. Local development is included by default.
ALLOWED_ORIGINS=https://voice.example.com,http://localhost:5173,http://127.0.0.1:5173

# Generate a long random value in production. Never commit the real secret.
IP_HASH_SECRET=

# Optional Cloudflare Turnstile protection. Leave both empty to disable it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

MAX_TEXT_CHARS=5000
HOURLY_REQUEST_LIMIT=10
DAILY_CHARACTER_LIMIT=50000
SYNTHESIS_WORKERS=2
QUEUE_MAXSIZE=8
AUDIO_RETENTION_SECONDS=3600
VOICE_CACHE_TTL_SECONDS=3600
OUTPUT_DIR=runtime/audio
